{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Wizz",
  "scopeName": "source.wizz",
  "patterns": [
    { "include": "#script" },
    { "include": "#comments" },
    { "include": "#blocks" },
    { "include": "#interpolation" },
    { "include": "#tags" }
  ],
  "repository": {
    "script": {
      "begin": "(<)(script)(?:\\s[^>]*)?(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.wizz" },
        "2": { "name": "entity.name.tag.wizz" },
        "3": { "name": "punctuation.definition.tag.end.wizz" }
      },
      "end": "(</)(script)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.wizz" },
        "2": { "name": "entity.name.tag.wizz" },
        "3": { "name": "punctuation.definition.tag.end.wizz" }
      },
      "contentName": "meta.embedded.block.javascript",
      "patterns": [{ "include": "source.js" }]
    },
    "comments": {
      "patterns": [{ "begin": "<!--", "end": "-->", "name": "comment.block.html" }]
    },
    "blocks": {
      "match": "\\{(?:#(?:if|each)\\b[^}]*|:else|/(?:if|each))\\}",
      "name": "keyword.control.wizz"
    },
    "interpolation": {
      "begin": "\\{",
      "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.wizz" } },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.wizz" } },
      "contentName": "meta.embedded.expression.wizz",
      "patterns": [{ "include": "source.js" }]
    },
    "tags": {
      "patterns": [
        {
          "begin": "</?",
          "beginCaptures": { "0": { "name": "punctuation.definition.tag.begin.wizz" } },
          "end": "/?>",
          "endCaptures": { "0": { "name": "punctuation.definition.tag.end.wizz" } },
          "name": "meta.tag.wizz",
          "patterns": [
            { "match": "[A-Za-z][A-Za-z0-9._-]*", "name": "entity.name.tag.wizz" },
            { "match": "\\bon:[A-Za-z][A-Za-z0-9_-]*", "name": "entity.other.attribute-name.event.wizz" },
            { "match": "[A-Za-z_:][A-Za-z0-9_:.-]*", "name": "entity.other.attribute-name.wizz" },
            { "include": "#interpolation" },
            { "include": "#strings" }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        { "begin": "\"", "end": "\"", "name": "string.quoted.double.wizz" },
        { "begin": "'", "end": "'", "name": "string.quoted.single.wizz" }
      ]
    }
  }
}