{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Wizz Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode-extension",
        "${workspaceFolder}"
      ]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run test.js",
      "program": "${workspaceFolder}/test.js",
      "console": "integratedTerminal"
    }
  ]
}