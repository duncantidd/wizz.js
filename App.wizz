<script>
  const frameworkName = "wizz.js";
  let clicks = 0;
  
  function handleClick() {
    clicks++;
  }

  function clickme() {
    alert('Hello ' + name + '\n There have been ' + clicks + ' clicks');
  }
  
  let params = new URLSearchParams(document.location.search);
  let name = params.get("name");

  if (!name) {
    name = "friend";
  }
</script>

<main>
  <h1 on:click={clickme}>Hello {name} Welcome to {frameworkName}!</h1>
  <p>Zero dependencies. 100% compiled. Fuck Tailwind and write your own css</p>
  <button on:click={handleClick}>Clicks: {clicks}</button>
</main>