<script>
  let count = persist('count', 0);
  let rawClicks = 0;

  export let showReset = false;

  function increment() {
    count += 1;
    rawClicks += 1;
  }

  function reset() {
    count = 0;
  }
</script>

<div>
  <button on:click={increment}>Increment Counter</button>
  <p>Clicks: {rawClicks}. Persisted clicks: {count}</p>
  {#if showReset}<button on:click={reset}>Reset</button>{/if}
</div>

<wizz:style>
  button {
    font-size: 18px;
    padding: 8px 16px;
    background: yellow;
    color: #542342;
  }
  p {
    color: yellow;
  }
</wizz:style>