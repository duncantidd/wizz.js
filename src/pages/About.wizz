<script>
    import Counter from '../components/Counter.wizz';
    const section = "Fruit";
    const fruits = [
      { id: 'apple', name: 'Apple' },
      { id: 'orange', name: 'Orange' },
      { id: 'pear', name: 'Pear' }
    ];
    const list = ['item1', 'item2'];
</script>

<main>
  <h1>The {section} section!</h1>
  <p>Lets build something. How about a counter?</p>
  {#if section === 'About'}
    <p>The counter will be rendered below</p>
    <Counter />
  {:else}
    <ul>
      {#each fruits as fruit (fruit.id)}
        <li>{fruit.name}</li>
      {/each}
    </ul>
    <ul>
      {#each list as item}
        <li>{item}</li>
      {/each}
    </ul>
  {/if}
</main>